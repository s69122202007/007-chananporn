<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Siam Savor | ร้านอาหารไทย</title>
<style>
:root{
  --bg:#fffaf3; --card:#ffffff; --ink:#24211e; --muted:#756d65;
  --brand:#e65b2f; --brand2:#f59a3d; --line:#eadfd3; --soft:#fff0df;
  --shadow:0 18px 45px rgba(71,43,20,.10);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans Thai",sans-serif;background:var(--bg);color:var(--ink)}
button,input,select{font:inherit}
button{cursor:pointer}
.nav{position:sticky;top:0;z-index:20;background:rgba(255,250,243,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav-inner{max-width:1120px;margin:auto;padding:16px 22px;display:flex;align-items:center;gap:18px}
.logo{font-weight:900;font-size:22px;color:var(--brand);margin-right:auto}
.logo span{color:var(--ink)}
.nav a{color:var(--ink);text-decoration:none;font-weight:700;padding:9px 12px;border-radius:12px}
.nav a:hover,.nav a.active{background:var(--soft);color:var(--brand)}
.cart{border:0;background:var(--ink);color:white;border-radius:999px;padding:10px 16px;font-weight:800}
.hero{max-width:1120px;margin:0 auto;padding:72px 22px 42px;display:grid;grid-template-columns:1.1fr .9fr;gap:38px;align-items:center}
.badge{display:inline-flex;background:var(--soft);color:var(--brand);font-weight:800;border-radius:999px;padding:8px 13px}
h1{font-size:clamp(42px,6vw,72px);line-height:.98;margin:18px 0}
h1 span{color:var(--brand)}
.lead{font-size:18px;line-height:1.7;color:var(--muted);max-width:650px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.btn{border:0;border-radius:14px;padding:13px 18px;font-weight:900}
.btn-primary{background:var(--brand);color:white}
.btn-secondary{background:white;border:1px solid var(--line);color:var(--ink)}
.hero-art{min-height:380px;border-radius:34px;background:radial-gradient(circle at 70% 20%,#ffc76b,transparent 28%),linear-gradient(145deg,#6f2419,#e65b2f 52%,#f8b35d);box-shadow:var(--shadow);display:grid;place-items:center;overflow:hidden;position:relative}
.plate{width:270px;height:270px;border-radius:50%;background:#fff;box-shadow:0 20px 30px rgba(0,0,0,.2);display:grid;place-items:center;font-size:130px;transform:rotate(-7deg)}
.floating{position:absolute;background:white;border:1px solid #ffffff88;border-radius:18px;padding:12px 15px;font-weight:900;box-shadow:0 12px 30px #0002}
.f1{top:35px;left:25px}.f2{right:25px;bottom:35px}
.section{max-width:1120px;margin:auto;padding:35px 22px 70px}
.section-head{display:flex;align-items:end;gap:18px;justify-content:space-between;margin-bottom:20px}
.section h2{font-size:34px;margin:0}
.muted{color:var(--muted)}
.filters{display:flex;gap:9px;flex-wrap:wrap;margin:18px 0}
.filter{border:1px solid var(--line);background:white;border-radius:999px;padding:9px 14px;font-weight:800}
.filter.active{background:var(--ink);color:white}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 7px 22px rgba(60,40,20,.05)}
.food{height:175px;display:grid;place-items:center;font-size:86px;background:linear-gradient(135deg,#fff0d8,#ffd39b)}
.card-body{padding:18px}
.card h3{margin:0 0 5px;font-size:20px}
.price{font-weight:950;color:var(--brand);font-size:20px}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.small-btn{border:0;background:var(--soft);color:var(--brand);border-radius:11px;padding:9px 12px;font-weight:900}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.info{padding:24px;background:white;border:1px solid var(--line);border-radius:22px}
.info .icon{font-size:32px}
.checkout{display:grid;grid-template-columns:1.1fr .9fr;gap:22px}
.panel{background:white;border:1px solid var(--line);border-radius:24px;padding:22px;box-shadow:0 8px 25px #4b321a08}
.cart-item{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}
.cart-emoji{width:50px;height:50px;border-radius:14px;background:var(--soft);display:grid;place-items:center;font-size:25px}
.qty{display:flex;align-items:center;gap:8px;margin-left:auto}
.qty button{border:1px solid var(--line);background:white;border-radius:8px;width:30px;height:30px}
.total{font-size:25px;font-weight:950;display:flex;justify-content:space-between;margin-top:18px}
.form{display:grid;gap:12px}
.form label{font-weight:800}
.form input,.form select{width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;background:white}
.notice{padding:14px;border-radius:14px;background:#fff7ea;color:#684b2c;line-height:1.6}
footer{background:#211b17;color:#eee;padding:35px 22px}
.footer-inner{max-width:1120px;margin:auto;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.hidden{display:none!important}
.empty{text-align:center;padding:35px;color:var(--muted)}
@media(max-width:820px){
 .hero,.checkout{grid-template-columns:1fr}.grid,.info-grid{grid-template-columns:1fr 1fr}.nav a{display:none}
}
@media(max-width:540px){.grid,.info-grid{grid-template-columns:1fr}.hero{padding-top:42px}.hero-art{min-height:300px}}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <div class="logo">Siam <span>Savor</span> 🍜</div>
    <a href="#home">หน้าแรก</a>
    <a href="#menu">เมนู</a>
    <a href="#checkout">ตะกร้า</a>
    <button class="cart" onclick="location.hash='checkout'">🛒 <span id="cartCount">0</span></button>
  </div>
</nav>

<main>
<section id="home" class="hero">
  <div>
    <div class="badge">ร้านอาหารไทย • อร่อยง่ายทุกวัน</div>
    <h1>รสชาติไทย<br><span>ที่อยากกลับมา</span></h1>
    <p class="lead">Siam Savor คือร้านอาหารไทยสไตล์โมเดิร์นที่รวมเมนูโปรดไว้ในที่เดียว เลือกอาหาร กรองตามหมวดหมู่ และสั่งซื้อได้จากหน้าเว็บ</p>
    <div class="hero-actions">
      <button class="btn btn-primary" onclick="location.hash='menu'">ดูเมนูทั้งหมด →</button>
      <button class="btn btn-secondary" onclick="showFeatured()">เมนูแนะนำ</button>
    </div>
  </div>
  <div class="hero-art">
    <div class="floating f1">⭐ 4.9/5 ลูกค้าชอบมาก</div>
    <div class="plate">🍛</div>
    <div class="floating f2">🔥 ข้าวกะเพรา 89.-</div>
  </div>
</section>

<section class="section">
  <div class="section-head"><div><h2>ทำไมต้อง Siam Savor?</h2><p class="muted">ออกแบบให้ใช้งานง่ายและนำหลักคณิตศาสตร์ดิสครีตมาใช้จริง</p></div></div>
  <div class="info-grid">
    <div class="info"><div class="icon">⚡</div><h3>สั่งง่าย</h3><p class="muted">เลือกเมนู → เพิ่มตะกร้า → ตรวจสอบรายการ</p></div>
    <div class="info"><div class="icon">🎯</div><h3>ค้นหาแม่นยำ</h3><p class="muted">ใช้ Set, filter, includes และ some ในการคัดเมนู</p></div>
    <div class="info"><div class="icon">🧠</div><h3>มีเงื่อนไข</h3><p class="muted">ระบบใช้ if-else และ AND/OR เพื่อคำนวณส่วนลด</p></div>
  </div>
</section>

<section id="menu" class="section">
  <div class="section-head">
    <div><h2>เมนูของเรา</h2><p class="muted">ค้นหาและกรองรายการอาหารได้ทันที</p></div>
    <input id="search" oninput="renderMenu()" placeholder="🔎 ค้นหาเมนู..." style="padding:12px 14px;border:1px solid var(--line);border-radius:13px;width:min(300px,100%)">
  </div>
  <div id="filters" class="filters"></div>
  <div id="menuGrid" class="grid"></div>
</section>

<section id="checkout" class="section">
  <div class="section-head"><div><h2>ตรวจสอบรายการ</h2><p class="muted">Checkout ก่อนยืนยันการสั่งซื้อ</p></div></div>
  <div class="checkout">
    <div class="panel">
      <h3>🛒 รายการในตะกร้า</h3>
      <div id="cartList"></div>
      <div class="total"><span>รวม</span><span id="grandTotal">฿0</span></div>
    </div>
    <div class="panel">
      <h3>ข้อมูลลูกค้า</h3>
      <div class="form">
        <label>ชื่อ</label><input id="customer" placeholder="เช่น น้องเจน">
        <label>วิธีรับอาหาร</label>
        <select id="pickup"><option>รับที่ร้าน</option><option>จัดส่ง</option></select>
        <label>โค้ดส่วนลด</label><input id="coupon" placeholder="ลองพิมพ์ SAVE10">
        <div class="notice" id="discountNotice">💡 ซื้อครบ ฿300 รับส่วนลดอัตโนมัติ 10%</div>
        <button class="btn btn-primary" onclick="placeOrder()">ยืนยันคำสั่งซื้อ</button>
      </div>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="footer-inner">
    <div><strong>Siam Savor 🍜</strong><br><span style="color:#b9ada4">อาหารไทยสไตล์โมเดิร์น</span></div>
    <div>เปิดทุกวัน 10:00–21:00 • โทร 02-123-4567</div>
  </div>
</footer>

<script>
// =========================
// ตัวอย่างการประยุกต์คณิตศาสตร์ดิสครีต
// Set + filter + includes + some + if-else + AND/OR
// =========================

const menu = [
 {id:1,name:"ข้าวกะเพราไก่ไข่ดาว",cat:"จานเดียว",price:89,emoji:"🍳",tags:["เผ็ด","ยอดนิยม"]},
 {id:2,name:"ผัดไทยกุ้งสด",cat:"จานเดียว",price:119,emoji:"🍤",tags:["เส้น","ยอดนิยม"]},
 {id:3,name:"ต้มยำกุ้ง",cat:"ต้ม/แกง",price:159,emoji:"🍲",tags:["เผ็ด","ซุป"]},
 {id:4,name:"แกงเขียวหวานไก่",cat:"ต้ม/แกง",price:139,emoji:"🥘",tags:["เผ็ด","แกง"]},
 {id:5,name:"ส้มตำไทย",cat:"ยำ/ส้มตำ",price:79,emoji:"🥗",tags:["เผ็ด","ผัก"]},
 {id:6,name:"ไก่ทอดน้ำปลา",cat:"ทานเล่น",price:99,emoji:"🍗",tags:["กรอบ","ยอดนิยม"]},
 {id:7,name:"ข้าวเหนียวมะม่วง",cat:"ของหวาน",price:89,emoji:"🥭",tags:["หวาน"]},
 {id:8,name:"ชาไทยเย็น",cat:"เครื่องดื่ม",price:59,emoji:"🧋",tags:["หวาน","เย็น"]}
];

// Set: หมวดหมู่ไม่ซ้ำกัน
const categories = ["ทั้งหมด", ...new Set(menu.map(item => item.cat))];

let selectedCategory = "ทั้งหมด";
let cart = [];

function renderFilters(){
  document.getElementById("filters").innerHTML = categories.map(c =>
    `<button class="filter ${c===selectedCategory?'active':''}" onclick="selectedCategory='${c}';renderFilters();renderMenu()">${c}</button>`
  ).join("");
}

function renderMenu(){
  const q = document.getElementById("search").value.trim().toLowerCase();

  // filter + includes: ค้นหาจากชื่อหรือแท็ก
  const result = menu.filter(item => {
    const categoryOK = selectedCategory === "ทั้งหมด" || item.cat === selectedCategory;
    const textOK = q === "" || item.name.toLowerCase().includes(q) || item.tags.some(tag => tag.includes(q));
    return categoryOK && textOK; // AND
  });

  document.getElementById("menuGrid").innerHTML = result.length ? result.map(item => `
    <article class="card">
      <div class="food">${item.emoji}</div>
      <div class="card-body">
        <div class="row"><span class="muted">${item.cat}</span><span class="price">฿${item.price}</span></div>
        <h3>${item.name}</h3>
        <p class="muted">${item.tags.join(" • ")}</p>
        <button class="small-btn" onclick="addToCart(${item.id})">+ เพิ่มลงตะกร้า</button>
      </div>
    </article>
  `).join("") : `<div class="empty" style="grid-column:1/-1">ไม่พบเมนูที่ตรงกับเงื่อนไข</div>`;
}

function addToCart(id){
  const found = cart.find(x => x.id === id);
  if(found) found.qty++;
  else cart.push({id,qty:1});
  updateCart();
  document.getElementById("cartCount").textContent = cart.reduce((s,x)=>s+x.qty,0);
}

function updateCart(){
  const list = document.getElementById("cartList");
  if(!cart.length){
    list.innerHTML = '<div class="empty">ยังไม่มีอาหารในตะกร้า<br>กลับไปเลือกเมนูได้เลย 🍜</div>';
  } else {
    list.innerHTML = cart.map(line=>{
      const item = menu.find(x=>x.id===line.id);
      return `<div class="cart-item">
        <div class="cart-emoji">${item.emoji}</div>
        <div><strong>${item.name}</strong><br><span class="muted">฿${item.price} × ${line.qty}</span></div>
        <div class="qty">
          <button onclick="changeQty(${item.id},-1)">−</button><strong>${line.qty}</strong><button onclick="changeQty(${item.id},1)">+</button>
        </div>
      </div>`;
    }).join("");
  }
  updateTotal();
}

function changeQty(id,delta){
  const line=cart.find(x=>x.id===id);
  if(!line)return;
  line.qty += delta;
  if(line.qty<=0) cart=cart.filter(x=>x.id!==id);
  document.getElementById("cartCount").textContent = cart.reduce((s,x)=>s+x.qty,0);
  updateCart();
}

function subtotal(){
  return cart.reduce((sum,line)=>{
    const item=menu.find(x=>x.id===line.id);
    return sum + item.price*line.qty;
  },0);
}

function updateTotal(){
  const sub=subtotal();
  const coupon=document.getElementById("coupon").value.trim().toUpperCase();
  // if-else + AND/OR: ครบ 300 หรือใช้โค้ด SAVE10
  const discount = (sub >= 300 || coupon === "SAVE10") ? Math.round(sub*0.10) : 0;
  document.getElementById("grandTotal").textContent = "฿"+(sub-discount);
  document.getElementById("discountNotice").innerHTML =
    discount ? `🎉 ได้ส่วนลด ฿${discount} (เงื่อนไข: ยอดถึง ฿300 <strong>หรือ</strong>ใช้โค้ด SAVE10)` :
    `💡 ซื้อครบ ฿300 <strong>หรือ</strong>ใช้โค้ด SAVE10 รับส่วนลด 10%`;
}

document.getElementById("coupon").addEventListener("input", updateTotal);

function placeOrder(){
  const name=document.getElementById("customer").value.trim();
  if(cart.length===0){
    alert("กรุณาเลือกอาหารก่อนยืนยันคำสั่งซื้อ");
  } else if(name===""){
    alert("กรุณากรอกชื่อ");
  } else {
    alert(`ขอบคุณคุณ ${name} 🎉\nสั่งอาหารเรียบร้อยแล้ว\nยอดชำระ ${document.getElementById("grandTotal").textContent}`);
  }
}

function showFeatured(){
  selectedCategory="ทั้งหมด";
  document.getElementById("search").value="ยอดนิยม";
  renderFilters();renderMenu();
  location.hash="menu";
}

function route(){
  // Hash: เปลี่ยนส่วนของเว็บไซต์ตาม #home / #menu / #checkout
  const hash=location.hash || "#home";
  document.querySelectorAll("main section").forEach(s=>s.classList.add("hidden"));
  const target=document.querySelector(hash);
  if(target) target.classList.remove("hidden");
  else document.getElementById("home").classList.remove("hidden");

  document.querySelectorAll(".nav a").forEach(a=>a.classList.toggle("active",a.getAttribute("href")===hash));
  if(hash==="#checkout") updateCart();
}
window.addEventListener("hashchange",route);

renderFilters();renderMenu();updateCart();route();
</script>
</body>
</html>
